<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsAppSDK>true</UseWindowsAppSDK>
    <!-- Zip-SDK workaround: MrtCore.PriGen.targets would otherwise auto-set 7 win10-* RIDs that this SDK's RID graph rejects (NETSDK1083). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- Pure-C# UI: no XAML items anywhere, so MarkupCompilePass1 is skipped entirely.
         EnableDefaultPageItems=false stops WindowsAppSDK from auto-globbing the legacy
         on-disk .xaml files into Page/ApplicationDefinition items (WMC0011 errors). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- This box's net472 XamlCompiler.exe dies silently; force the in-proc MSBuild CompileXaml task instead. -->
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <!-- Zip-SDK workaround (runtime): MddBootstrap cannot detect the installed WindowsAppRuntime 1.5 on this box and aborts startup with an install dialog. Self-contained deployment mode bundles the runtime next to the exe so no installed package is required. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Self-contained mode rejects AnyCPU; pin the x64 platform/runtime. -->
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseAppHost>true</UseAppHost>

    <!-- App icon: embedded into the exe (Explorer/taskbar/Alt-Tab). Regenerate with
         tools/make_icon.py (see readme.md "App icon"). -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>

    <!-- Zip-SDK workaround: MrtCore's PRI tooling chain (MrtCore.PriGen.targets) calls MSBuild tasks whose DLLs are absent from this zip SDK (MSB4062). No XAML/PRI resources exist, so opt out of the whole chain. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 2.x (latest stable line; was 1.5 before user directive). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <!-- Win2D = Direct2D GPU rendering: the grid is drawn onto one CanvasControl instead of
         1920 XAML cell elements (no per-cell layout pass; CPU encodes, GPU rasterizes). -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.0" />
    <ProjectReference Include="..\NvimCore\NvimCore.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Ship the .ico next to the exe so the window can set it explicitly at runtime (MainWindow ctor);
         the EXE already carries the same icon via <ApplicationIcon>. -->
    <None Update="Assets\appicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <ItemGroup>
    <!-- Only the pure-C# partials are compiled; legacy XAML-era sources stay on disk, excluded. -->
    <Compile Include="Program.cs" />
    <Compile Include="App.cs" />
    <Compile Include="MainWindow.cs" />
    <Compile Include="MainWindow.notify.cs" />
    <Compile Include="MainWindow.render.cs" />
    <Compile Include="MainWindow.multigrid.cs" />
    <Compile Include="MainWindow.mouse.cs" />
    <!-- IME: native Win32 EDIT target that receives the OS IME's committed text. -->
    <Compile Include="MainWindow.ime.cs" />
    <!-- IME: Windows-Terminal-shaped TSF composition host. A transitory ITfContext on a PLAIN
         window; no ITextStoreACP. Measured working (PREVIEW 'にほんご' -> COMMIT 'にほんご'). -->
    <Compile Include="Tsf\TsfCompositionHost.cs" />
    <Compile Include="MainWindow.tsfhost.cs" />
    <!-- IME: TSF text store (MSIME is a TSF IME; IMM32 alone cannot make it compose). -->
    <!-- MainWindow.tsf.cs removed: hand-rolled TSF text store (the .NET CCW path crashed).
         IME now targets RICHEDIT50W (msftedit.dll), which ships its own OS-provided store. -->
  </ItemGroup>
</Project>
